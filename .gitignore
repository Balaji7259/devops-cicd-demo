# Never commit secrets or machine-specific files.

# Environment / secrets
.env
.env.*
*.pem
*.key

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Build byproducts (regenerate with build/make_resume.py)
build/resume-preview.png
resume/_sweep_*.pdf


# Composite is regenerated by build/make_post_image.py; the copy that ships lives in docs/social/
shots/linkedin-post.png

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node (not used here, but keeps contributors from committing it)
node_modules/
dist/

# Editors and IDEs
.vscode/
.idea/
*.swp
